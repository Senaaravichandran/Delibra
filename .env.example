# VerdictForge runtime configuration
# Copy to .env, add at least one provider key, then run the application.

VERDICTFORGE_ENVIRONMENT=development
VERDICTFORGE_LOG_LEVEL=INFO
VERDICTFORGE_DATABASE_PATH=data/verdictforge.db
VERDICTFORGE_REQUEST_TIMEOUT_SECONDS=60
VERDICTFORGE_MAX_CONCURRENT_MODELS=4
VERDICTFORGE_MAX_QUESTION_LENGTH=12000
VERDICTFORGE_RATE_LIMIT_PER_MINUTE=10
VERDICTFORGE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional shared secret. When set, API clients must send it as X-API-Key.
VERDICTFORGE_API_KEY=

# Provider credentials. Never commit real values.
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_OPENAI_API_KEY=your_nvidia_api_key_here

# Model routing can be changed without editing source code.
VERDICTFORGE_GROQ_MODEL=llama-3.3-70b-versatile
VERDICTFORGE_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
VERDICTFORGE_GPT_OSS_MODEL=openai/gpt-oss-20b
VERDICTFORGE_JUDGE_MODEL_ID=llama-3.3-70b
