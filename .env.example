# Delibra runtime configuration
# Copy to .env, add at least one provider key, then run the application.

DELIBRA_ENVIRONMENT=development
DELIBRA_LOG_LEVEL=INFO
DELIBRA_DATABASE_PATH=data/delibra.db
DELIBRA_REQUEST_TIMEOUT_SECONDS=60
DELIBRA_MAX_CONCURRENT_MODELS=4
DELIBRA_MAX_QUESTION_LENGTH=12000
DELIBRA_RATE_LIMIT_PER_MINUTE=10
DELIBRA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional shared secret. When set, API clients must send it as X-API-Key.
DELIBRA_API_KEY=

# Provider credentials. Never commit real values.
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_OPENAI_API_KEY=your_nvidia_api_key_here

# Model routing can be changed without editing source code.
DELIBRA_GROQ_MODEL=qwen/qwen3.6-27b
DELIBRA_GROQ_JUDGE_MODEL=openai/gpt-oss-120b
DELIBRA_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DELIBRA_GPT_OSS_MODEL=openai/gpt-oss-20b
DELIBRA_JUDGE_MODEL_ID=gpt-oss-120b
